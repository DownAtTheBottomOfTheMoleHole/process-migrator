{
  "compilerOptions": {
    "noImplicitAny": false,
    "noImplicitThis": true,
    "lib": ["es2020", "dom"],
    "outDir": "../../build/nodejs",
    "preserveConstEnums": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "../common/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}