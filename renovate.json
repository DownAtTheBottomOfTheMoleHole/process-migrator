{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enableVulnerabilityAlerts", "group:allNonMajor", "helpers:pinGitHubActionDigests"],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "schedule": ["before 7am on monday"],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 1,
    "labels": ["security", "renovate"],
    "automerge": false
  }
}
